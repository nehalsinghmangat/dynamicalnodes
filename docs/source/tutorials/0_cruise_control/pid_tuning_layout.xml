<?xml version='1.0' encoding='UTF-8'?>
<root>
 <tabbed_widget name="Main Window" parent="main_window">
  <Tab containers="1" tab_name="tab1">
   <Container>
    <DockSplitter count="2" orientation="-" sizes="0.5;0.5">
     <DockArea name="...">
      <plot line_width="1.0" flip_x="false" mode="TimeSeries" flip_y="false">
       <range left="0.0" top="35.0" right="30.0" bottom="10.0"/>
       <limitY/>
       <curve name="/rk/data" color="#ff7f0e"/>
       <curve name="/xhatk/data" color="#005fff"/>
      </plot>
     </DockArea>
     <DockArea name="...">
      <plot line_width="1.0" flip_x="false" mode="TimeSeries" flip_y="false">
       <range left="0.0" top="3000.0" right="30.0" bottom="-3000.0"/>
       <limitY/>
       <curve name="/uk/data" color="#d62728"/>
      </plot>
     </DockArea>
    </DockSplitter>
   </Container>
  </Tab>
  <currentTabIndex index="0"/>
 </tabbed_widget>
 <use_relative_time_offset enabled="1"/>
